<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Concert Booking | Admin Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #f4f4f4;
            font-family: Arial, sans-serif;
        }
        .sidebar {
            width: 250px;
            height: 100vh;
            position: fixed;
            background: #343a40;
            color: white;
            padding-top: 20px;
        }
        .sidebar h2 {
            text-align: center;
            font-size: 20px;
            margin-bottom: 20px;
        }
        .sidebar ul {
            list-style: none;
            padding: 0;
        }
        .sidebar ul li {
            padding: 15px;
            text-align: left;
        }
        .sidebar ul li a {
            color: white;
            text-decoration: none;
            display: block;
        }
        .sidebar ul li a:hover {
            background: #495057;
        }
        .content {
            margin-left: 250px;
            padding: 20px;
        }
        .card {
            border-radius: 10px;
            box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <nav class="sidebar">
        <h2>Admin Panel</h2>
        <ul>
            <li><a href="#"><i class="fas fa-home"></i> Dashboard</a></li>
            <li><a href="/concerts"><i class="fas fa-music"></i> Concerts</a></li>
            <li><a href="/bookings/adminbookings"><i class="fas fa-ticket-alt"></i> Bookings</a></li>
            <li><a href="#"><i class="fas fa-users"></i> Users</a></li>
            <li><a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
        </ul>
    </nav>

    <!-- Main Content -->
    <div class="content">
        <h2 class="mb-4">Dashboard</h2>

        <div class="row">
            <div class="col-md-4">
                <div class="card text-white bg-primary p-3">
                    <h4><i class="fas fa-music"></i> Total Concerts</h4>
                    <p>20 Upcoming Concerts</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-white bg-success p-3">
                    <h4><i class="fas fa-ticket-alt"></i> Total Bookings</h4>
                    <p>500 Tickets Sold</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-white bg-warning p-3">
                    <h4><i class="fas fa-users"></i> Total Users</h4>
                    <p>120 Registered Users</p>
                </div>
            </div>
        </div>

        <!-- Recent Bookings -->
        <div class="card mt-4">
            <div class="card-header bg-dark text-white">
                <h5><i class="fas fa-list"></i> Recent Bookings</h5>
            </div>
            <div class="card-body">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Booking ID</th>
                            <th>User</th>
                            <th>Concert</th>
                            <th>Seats</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>#00123</td>
                            <td>John Doe</td>
                            <td>Coldplay Live</td>
                            <td>3</td>
                            <td><span class="badge bg-success">Confirmed</span></td>
                        </tr>
                        <tr>
                            <td>#00124</td>
                            <td>Jane Smith</td>
                            <td>Ed Sheeran Tour</td>
                            <td>2</td>
                            <td><span class="badge bg-warning">Pending</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

</body>
</html>
