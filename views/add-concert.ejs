<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Concert</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body {
            background: #f8f9fa;
            font-family: 'Poppins', sans-serif;
        }
        .container {
            max-width: 600px;
            margin-top: 50px;
        }
        .card {
            background: #ffffff;
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
            border: none;
        }
        .form-control {
            background: #f1f1f1;
            border: none;
            padding: 10px;
            border-radius: 5px;
        }
        .form-control:focus {
            background: #ffffff;
            box-shadow: 0px 0px 5px rgba(0, 0, 0, 0.2);
            border: 1px solid #007bff;
        }
        .btn-success {
            background: #007bff;
            border: none;
            transition: 0.3s ease;
        }
        .btn-success:hover {
            background: #0056b3;
            transform: scale(1.05);
        }
        .btn-secondary {
            transition: 0.3s ease;
        }
        .btn-secondary:hover {
            transform: scale(1.05);
        }
        .image-preview {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-radius: 10px;
            display: none;
            margin-top: 10px;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="card">
        <h2 class="text-center mb-4">🎤 Add Concert</h2>
        
        <form action="/concerts/add" method="POST" enctype="multipart/form-data">
            <div class="mb-3">
              <label class="form-label">Concert Name</label>
              <input type="text" class="form-control" name="name" placeholder="Enter concert name" required>
            </div>
          
            <div class="mb-3">
              <label class="form-label">Date</label>
              <input type="date" class="form-control" name="date" required>
            </div>
          
            <div class="mb-3">
              <label class="form-label">Time</label>
              <input type="time" class="form-control" name="time" required>
            </div>
          
            <div class="mb-3">
              <label class="form-label">Duration (in hours)</label>
              <input type="number" step="0.5" class="form-control" name="duration" placeholder="e.g., 2.5" required>
            </div>
          
            <div class="mb-3">
              <label class="form-label">Languages (comma-separated)</label>
              <input type="text" class="form-control" name="languages" placeholder="e.g., English, Hindi" required>
            </div>
          
            <div class="mb-3">
              <label class="form-label">Genres (comma-separated)</label>
              <input type="text" class="form-control" name="genres" placeholder="e.g., Pop, Rock" required>
            </div>
          
            <div class="mb-3">
              <label class="form-label">Venue</label>
              <input type="text" class="form-control" name="venue" placeholder="Enter venue location" required>
            </div>
          
            <div class="mb-3">
              <label class="form-label">Number of Seats</label>
              <input type="number" class="form-control" name="seats" placeholder="Total seats available" required>
            </div>
          
            <div class="mb-3">
              <label class="form-label">Price (in Rupees)</label>
              <input type="number" class="form-control" name="price" placeholder="Enter ticket price" required>
            </div>
          
            <div class="mb-3">
              <label class="form-label">Description</label>
              <textarea class="form-control" name="description" rows="3" placeholder="Enter concert details (e.g. performers, theme, etc.)" required></textarea>
            </div>
          
            <div class="mb-3">
              <label class="form-label">Concert Image</label>
              <input type="file" class="form-control" name="image" id="imageInput" accept="image/*">
              <img id="imagePreview" class="image-preview mt-2" style="max-width: 100%; display: none;">
            </div>
          
            <button type="submit" class="btn btn-success w-100">🎶 Add Concert</button>
            <a href="/admin/concerts" class="btn btn-secondary w-100 mt-2">🔙 Cancel</a>
          </form>
          

<!-- Bootstrap & Script -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.getElementById('imageInput').addEventListener('change', function(event) {
        const preview = document.getElementById('imagePreview');
        const file = event.target.files[0];

        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                preview.src = e.target.result;
                preview.style.display = 'block';
            };
            reader.readAsDataURL(file);
        } else {
            preview.style.display = 'none';
        }
    });
</script>
</body>
</html>
