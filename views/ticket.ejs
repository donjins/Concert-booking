<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Your Concert Ticket</title>
  <style>
    body {
      font-family: 'Segoe UI', sans-serif;
      background: #fff;
      margin: 0;
      padding: 40px;
      display: flex;
      justify-content: center;
    }

    .ticket-wrapper {
      position: relative;
      width: 794px; 
      background: #fff;
      border-radius: 20px;
      box-shadow: 0 10px 20px rgba(0,0,0,0.1);
      overflow: hidden;
      padding: 30px 40px;
    }

    .download-btn {
      position: absolute;
      top: 20px;
      right: 30px;
      background-color: #d81f26;
      color: #fff;
      border: none;
      padding: 10px 16px;
      border-radius: 8px;
      font-weight: bold;
      cursor: pointer;
      transition: background-color 0.3s ease;
      
    }

    .download-btn:hover {
      background-color: #b91c1c;
    }

    .ticket-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 25px;
      border-bottom: 2px dashed #ccc;
      padding-bottom: 10px;
    }

    .ticket-header h2 {
      margin: 0;
      font-size: 1.6rem;
    }

    .ticket-section {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      margin-top: 20px;
    }

    .left-info, .right-info {
      flex: 1;
    }

    .info-block {
      margin-bottom: 15px;
    }

    .info-block span {
      font-weight: bold;
      display: block;
      margin-bottom: 5px;
      color: #555;
    }

    .barcode {
      margin-top: 30px;
      text-align: center;
    }

    .barcode img {
      width: 150px;
    }

    .footer-note {
      font-size: 0.8rem;
      color: #666;
      text-align: center;
      margin-top: 20px;
    }
  </style>
</head>
<body>
  <button class="download-btn" onclick="downloadTicket()">Download Ticket</button>
  <div class="ticket-wrapper" id="ticket">
    

    <div class="ticket-header">
      <h2><%= concert.name %></h2>
      <div><%= concert.date %> at <%= concert.time %></div>
    </div>

    <div class="ticket-section">
      <div class="left-info">
        <div class="info-block">
          <span>Venue</span>
          <p><%= concert.venue %></p>
        </div>
        <div class="info-block">
          <span>Ticket Holder</span>
          <p><%= user.name %></p>
        </div>
        <div class="info-block">
          <span>Quantity</span>
          <p><%= quantity %> Ticket(s)</p>
        </div>
      </div>

      <div class="right-info">
        <div class="info-block">
          <span>Booking ID</span>
          <p>#<%= bookingId.slice(-6).toUpperCase() %></p>
        </div>
        <div class="info-block">
          <span>Total Price</span>
          <p>₹<%= totalPrice.toFixed(2) %></p>
        </div>
        <div class="info-block">
          <span>Booking Fee</span>
          <p>₹123.82</p>
        </div>
        <div class="info-block">
          <span>Grand Total</span>
          <p><strong>₹<%= (totalPrice + 123.82).toFixed(2) %></strong></p>
        </div>
      </div>
    </div>

    <div class="barcode">
      <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=<%= bookingId %>" alt="QR Code">
    </div>

    <div class="footer-note">
      Please present this ticket at the entrance. Enjoy the show!
    </div>
  </div>

  <script>
    function downloadTicket() {
      const element = document.getElementById('ticket');
  
      // Temporarily hide the download button in PDF
      const btn = document.querySelector('.download-btn');
      btn.style.display = 'none';
  
      html2pdf().from(element).set({
        margin: 10,
        filename: 'Concert-Ticket.pdf',
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2, useCORS: true },
        jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
      }).save().then(() => {
        btn.style.display = 'block'; // Show button again
      });
    }
  </script>
  

  <!-- Add html2canvas library -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <!-- html2pdf library -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

  

</body>
</html>
